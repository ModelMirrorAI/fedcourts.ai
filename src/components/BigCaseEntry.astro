---
// One board row: the case, each model's current big-case score and the panel
// average; expands to the case's predicted events and every model's newest
// read of each. Styled by BigCaseBoard.astro (global styles under .board).
import ledger from "../data/ledger.json";
import { momentFor, plainCall, plainOutcome, topicName, MOMENT_ORDER } from "../lib/moments.js";
import CaseTimeline from "./CaseTimeline.astro";

const { row } = Astro.props;
const predictors = ledger.metrics?.big_cases?.predictors ?? [];

const shortName = (id) => {
  const base = id.replace(/-baseline$/, "");
  return base.charAt(0).toUpperCase() + base.slice(1);
};
const score = (x) => (typeof x === "number" ? x.toFixed(2) : "—");
const pct = (x) => (typeof x === "number" ? `${Math.round(x * 100)}%` : "—");
const day = (iso) => (iso ? String(iso).slice(0, 10) : "");
const statusLabel = { pending: "awaiting the Court", partly_resolved: "partly decided", resolved: "decided" };
const reads = new Map((row.current_reads ?? []).map((r) => [r.predictor_id, r]));

// The case's newest plain-language summary, if the ledger has one (docs/case-summaries.md).
const summary = ledger.summaries?.[row.case_id] ?? null;
const MODEL_NAMES = { "claude-sonnet-5": "Claude Sonnet 5" };
const modelName = (id) => MODEL_NAMES[id] ?? id;
const longDate = (d) =>
  d ? new Date(`${String(d).slice(0, 10)}T00:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }) : "";
const repo = ledger.source?.repo ?? "ModelMirrorAI/fedcourtsai";
// The case's question-presented topic, if the labeler has reached it (docs/qp-topic.md).
const topic = ledger.topics?.[row.case_id] ?? null;
const docketNumber = ledger.docket_numbers?.[row.case_id] ?? null;
const topicPrimary = topic && topicName(topic.label);
const topicSecondary = topic?.secondary && topic.secondary !== topic.label ? topicName(topic.secondary) : null;

// The case's predicted events in the order they happened: by the date each
// opened (from the ledger rows), then by the moment register's own order.
const openedAt = new Map((ledger.rows ?? []).map((r) => [`${r.court}/${r.docket}/${r.event_id}`, r.opened_at]));
const rank = (id) => { const i = MOMENT_ORDER.indexOf(id); return i < 0 ? MOMENT_ORDER.length : i; };
const events = (row.events ?? [])
  .map((ev) => ({ ...ev, opened_at: openedAt.get(`${row.case_id}/${ev.event_id}`) ?? null }))
  .sort((a, b) => rank(a.event_id) - rank(b.event_id) || String(a.opened_at ?? "").localeCompare(String(b.opened_at ?? "")));
// One radio per event; the newest is selected by default. The timeline's
// steps are labels for these, and CSS shows the selected event's predictions.
const slug = row.case_id.replace(/[^a-z0-9]+/gi, "-");
const ids = events.map((ev) => `pick-${slug}-${ev.event_id}`);
const selected = events.length - 1;

const isCurrent = (read, eventId) => {
  const c = reads.get(read.predictor_id);
  return Boolean(c && c.event_id === eventId && c.run_id === read.run_id);
};
---
<details class="entry" data-docket={docketNumber ?? undefined} data-case={row.case_id}>
  <summary class="row">
    <div class="case">
      <span class="caption">{row.caption ?? row.case_id}</span>
      <span class="meta">
        {topicPrimary && <span class="tag topic">{topicPrimary}</span>}
        <span class="tag">{statusLabel[row.status] ?? row.status}</span>
        {row.leakage_suspected && <a class="tag warn" href="#possible-leak">possible leak</a>}
      </span>
    </div>
    {predictors.map((p) => {
      const r = reads.get(p);
      return <div class="num" data-label={shortName(p)}>{r ? score(r.big_case_score) : "—"}</div>;
    })}
    <div class="num mean" data-label="Average">
      {score(row.mean_big_case_score)}
      {row.n < predictors.length && <small> {row.n} of {predictors.length} models</small>}
      {typeof row.mean_big_case_score === "number" && (
        <span class="bar" aria-hidden="true"><span style={`width:${Math.round(row.mean_big_case_score * 100)}%`}></span></span>
      )}
    </div>
  </summary>

  <div class="body">
    <p class="ident">
      <span class="full">{row.caption}</span>
      {docketNumber && <span>No. {docketNumber} · </span>}
      <span class="mono">{row.case_id}</span>
      {typeof row.score_range === "number" && <span> · models differ by up to {score(row.score_range)}</span>}
      {topicPrimary && <span> · topic: <a href="/how-it-works#case-topics">{topicPrimary}{topicSecondary && ` (also ${topicSecondary})`}</a></span>}
    </p>
    {summary && (
      <section class="summary" aria-label="Case summary">
        <div class="cols">
          {summary.sections.map((sec) => (
            <div class="col">
              <h3>{sec.heading}</h3>
              {sec.paragraphs.map((para) => <p>{para}</p>)}
            </div>
          ))}
        </div>
        <p class="provenance">
          Plain-language summary written by {modelName(summary.model)} from the Court's docket and filings
          as of {longDate(summary.snapshot)}. It is AI-generated and can contain mistakes.{" "}
          <a href="/how-it-works#case-summaries">About these summaries</a>{" · "}
          <a href={`https://github.com/${repo}/blob/main/${summary.path}`}>source file ↗</a>
        </p>
      </section>
    )}
    <h3 class="predictions-head">Progress at the Court</h3>
    <div class="picks">
      {ids.map((id, i) => <input type="radio" class="pick" name={`pick-${slug}`} id={id} checked={i === selected} />)}
    </div>
    <CaseTimeline events={events} ids={ids} />
    <h3 class="predictions-head">The models' predictions</h3>
    {events.length > 1 && <p class="pick-hint">The models predicted this case at {events.length} points. The newest is shown; choose a marked step on the timeline to see the others.</p>}
    <div class="events">
    {events.map((ev) => {
      // An id outside the register (entry-pinned or legacy) falls back to the cert reading.
      const mo = momentFor(ev.event_id);
      const stage = mo?.stage ?? "cert";
      const chance = mo?.chance ?? "Chance the Court takes the case";
      const hasCall = mo?.hasCall ?? true;
      return (
      <div class="event">
        <h3>
          {mo?.question ?? ev.title ?? ev.event_id}
          <span class="ev-meta">
            {mo && <span>Predicted {mo.when}. </span>}
            {ev.actual_disposition
              ? <span>Decided {day(ev.resolved_at)}: the Court <strong>{plainOutcome(stage, ev.actual_disposition)}</strong>.</span>
              : <span>Awaiting the Court.</span>}
            <span class="mono"> {ev.event_id}</span>
          </span>
        </h3>
        <ul class="reads">
          {(ev.reads ?? []).map((r) => (
            <li class:list={["read", { current: isCurrent(r, ev.event_id) }]}>
              <div class="read-head">
                <span class="who">{shortName(r.predictor_id)}</span>
                <span class="figs">
                  Big-case score <strong>{score(r.big_case_score)}</strong>
                  <span class="sep">·</span>
                  {chance}: <strong>{pct(r.probability)}</strong>
                  {hasCall && <Fragment><span class="sep">·</span>Prediction: <em>{plainCall(stage, r.predicted_disposition)}</em></Fragment>}
                  {r.leakage_suspected && <a class="tag warn" href="#possible-leak">possible leak</a>}
                  {isCurrent(r, ev.event_id) && <span class="tag">used in average</span>}
                </span>
                {r.cell_url && <a class="cell" href={r.cell_url}>full prediction on GitHub ↗</a>}
              </div>
              {r.big_case_rationale && <p class="why">{r.big_case_rationale}</p>}
            </li>
          ))}
        </ul>
      </div>
      );
    })}
    </div>
  </div>
</details>
