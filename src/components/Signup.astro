---
// Email signup: a plain HTML form posting to Buttondown's embed endpoint.
// No JavaScript, no third-party script, nothing loaded from Buttondown until
// someone submits. After submitting, Buttondown redirects to /subscribe/check-email;
// the confirmation link lands on /subscribe/confirmed (both set in Buttondown's
// settings).
//
// Each checkbox sends a `tag` that Buttondown attaches to the subscriber; the
// pipeline addresses each feed's emails to its tag. Release announcements go to
// everyone and need no box; the line under the boxes says so. The AI-case boxes record interest ahead of that
// feed, which says so on its label.
const { lead = "Get FedCourtsAI updates by email", id = "signup-email" } = Astro.props;
---
<form class="signup" action="https://buttondown.com/api/emails/embed-subscribe/fedcourtsai" method="post">
  <label for={id}>{lead}</label>
  <div class="signup-row">
    <input type="email" name="email" id={id} required autocomplete="email" placeholder="you@example.com" />
    <input type="hidden" name="embed" value="1" />
    <button type="submit">Sign up</button>
  </div>
  <fieldset class="signup-feeds">
    <legend>Choose what you get:</legend>
    <label><input type="checkbox" name="tag" value="weekly-scotus" checked /><span>Weekly Supreme Court update, most weeks: what resolved against each model's forecast, and the week's new forecasts</span></label>
    <label><input type="checkbox" name="tag" value="ai-cases" /><span>AI cases: new filings and rulings in AI-related litigation <span class="soon">(starting later)</span></span></label>
    <label class="nested"><input type="checkbox" name="tag" value="ai-cases-predictions" /><span>…with the models' forecasts on those cases</span></label>
  </fieldset>
  <small>Everyone also gets release announcements, two to four a year. Unsubscribe or change these anytime. <a href="/privacy#email-updates">How your address is used</a>.</small>
</form>

<style>
  .signup { margin: 1.5rem 0 1.75rem; }
  .signup label { display: block; font-weight: 560; margin-bottom: 0.35rem; }
  .signup-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.35rem; max-width: 32rem; }
  .signup input[type="email"] {
    flex: 1 1 14rem; min-width: 0;
    font: inherit; color: var(--ink); background: var(--paper);
    border: 1px solid var(--rule); border-radius: 3px; padding: 0.4rem 0.6rem;
  }
  .signup input[type="email"]::placeholder { color: var(--muted); }
  /* The accent is never a fill: an outlined button, tinted on hover. */
  .signup button {
    font: inherit; color: var(--accent); background: transparent; cursor: pointer;
    border: 1px solid var(--accent); border-radius: 3px; padding: 0.4rem 1rem;
  }
  .signup button:hover { background: var(--accent-soft); }
  .signup small { display: block; }
  .signup-feeds { border: 0; margin: 0 0 0.5rem; padding: 0; max-width: 40rem; }
  .signup-feeds legend { padding: 0; margin-bottom: 0.25rem; font-size: 0.95em; }
  .signup-feeds label {
    display: flex; gap: 0.45rem; align-items: baseline;
    font-weight: 400; font-size: 0.95em; margin: 0 0 0.2rem;
  }
  .signup-feeds input { accent-color: var(--accent); flex: none; }
  .signup-feeds label.nested { padding-left: 1.6rem; }
  .signup-feeds .soon { color: var(--muted); }
</style>
