---
// "Updated <date> · ledger commit <sha>": the exact fedcourtsai commit this build read.
import ledger from "../data/ledger.json";
const { sha, committed_at, repo } = ledger.source;
const short = sha ? sha.slice(0, 7) : "unknown";
const when = committed_at
  ? new Date(committed_at).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })
  : "";
---
<span class="stamp">{when && `Updated ${when} · `}ledger commit {sha ? <a href={`https://github.com/${repo}/commit/${sha}`}>{short}</a> : short}</span>
