---
// "ledger <sha> · <time>": the exact fedcourtsai commit this build read.
import ledger from "../data/ledger.json";
const { sha, committed_at, repo } = ledger.source;
const short = sha ? sha.slice(0, 7) : "unknown";
const when = committed_at ? committed_at.slice(0, 10) : "";
---
<span class="stamp">ledger {sha ? <a href={`https://github.com/${repo}/commit/${sha}`}>{short}</a> : short}{when && ` · ${when}`}</span>
