---
// The key to an expanded board row: what each event id is, why one case carries
// several, and how the probability and the call relate. Static copy over the
// moment register in src/lib/moments.js. Collapsed by default so the board stays
// near the top of the page.
import { MOMENTS, STAGES, STAGE_ORDER } from "../lib/moments.js";

const groups = STAGE_ORDER.map((stage) => ({
  stage,
  ...STAGES[stage],
  events: Object.entries(MOMENTS).filter(([, v]) => v.stage === stage),
}));
---
<details class="key" id="reading-a-case">
  <summary>How to read an expanded case</summary>

  <h2>Events</h2>
  <p>
    An event is one question about one case, asked at one point in time. There are three stages, each with its own question:
  </p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr><th>Event</th><th>Forecast taken</th></tr>
      </thead>
      {groups.map((g) => (
        <tbody>
          <tr class="stage"><th colspan="2">{g.label} — {g.question}</th></tr>
          {g.events.map(([id, v]) => (
            <tr><td class="mono">{id}</td><td>{v.when}</td></tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>

  <h2>Why one case has several events</h2>
  <p>
    We produce predictions for a given outcome at multiple times during the lifecycle of a case. Cases can also move to different stages (e.g. from cert to merits).
  </p>

    <h2>The probability and the call</h2>
  <p>
    Each prediction gives a <strong>probability</strong> and a <strong>call</strong>. The probability is the number we score: the chance
    of a grant at cert and interim, and the chance the judgment below is reversed or vacated at merits. The call is the single outcome
    the model thinks most likely, so “P(granted) 12%, called <em>denied</em>” is one position, not two.
  </p>
  <p>
    At cert, calls such as <span class="mono">gvr</span> and <span class="mono">summary-reversal</span> count as grants. At interim, a partial grant counts as a denial.
    Merits predictions have no call; the predicted judgment and votes are in the linked prediction.
  </p>
</details>

<style>
  .key { margin: 1.2rem 0 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .key > summary { cursor: pointer; padding: 0.6rem 0; font-weight: 560; }
  .key[open] { padding-bottom: 0.6rem; }
  .key h2 { font-size: 1.05rem; margin: 1.4em 0 0.4em; }
  .key h2:first-of-type { margin-top: 0.6em; }
  .key p { max-width: var(--measure); font-size: 0.95rem; }
  .key table { max-width: var(--measure); }
  .key .table-scroll table { min-width: 0; }
  .key tr.stage th { font-weight: 560; font-size: 0.86rem; color: var(--muted); border-bottom-color: var(--rule); padding-top: 0.9rem; }
  .key td.mono { white-space: normal; overflow-wrap: anywhere; padding-right: 1rem; }
</style>
