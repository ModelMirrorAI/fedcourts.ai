---
// The big-case board: one row per predicted case, each model's current
// big-case score and the panel average, ranked average-first. Rendered straight
// from metrics/big-cases.json as copied into ledger.json at build time; nothing
// is recomputed here. Rows expand (plain <details>, no JS) to the case's predicted
// events and every model's newest read of each, linked to the committed cell.
// The first SHOW rows are open to the page; the rest sit behind a second <details>.
import ledger from "../data/ledger.json";
import Entry from "./BigCaseEntry.astro";
import { topicKey, topicName } from "../lib/moments.js";

const SHOW = 25;

const board = ledger.metrics?.big_cases ?? null;
const predictors = board?.predictors ?? [];
const rows = board?.rows ?? [];
const top = rows.slice(0, SHOW);
const rest = rows.slice(SHOW);

// Topic filter chips: one per primary topic on the board, largest first, then
// "No topic" for the cases that show no tag. Counts are over the whole board.
const topicCounts = new Map();
for (const row of rows) {
  const k = topicKey(ledger.topics?.[row.case_id]);
  topicCounts.set(k, (topicCounts.get(k) ?? 0) + 1);
}
const noTopic = topicCounts.get("none") ?? 0;
const chips = [...topicCounts]
  .filter(([k]) => k !== "none")
  .map(([k, n]) => ({ key: k, name: topicName(k), n }))
  .sort((a, b) => b.n - a.n || a.name.localeCompare(b.name));

// Display names: strip the "-baseline" suffix the ledger uses and capitalize.
const shortName = (id) => {
  const base = id.replace(/-baseline$/, "");
  return base.charAt(0).toUpperCase() + base.slice(1);
};

// Timeline selection without JavaScript: each entry holds one radio per
// predicted event (.pick) and the events in the same order (.event). Once a
// radio is checked, only the event in the matching position shows, and the
// matching timeline step is highlighted. One rule per position, up to the
// number of declared moments. Browsers without :has() show every event.
const MAX_EVENTS = 12;
const pickCss = Array.from({ length: MAX_EVENTS }, (_, i) => i + 1).map((k) => `
  .board .body:has(.pick:nth-of-type(${k}):checked) .events > .event:nth-of-type(${k}) { display: block; }
  .board .body:has(.pick:nth-of-type(${k}):checked) .timeline label[data-k="${k}"] { --sel: 1; }
  .board .body:has(.pick:nth-of-type(${k}):checked) .timeline label[data-k="${k}"] .dot { background: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft), 0 0 0 4px var(--accent); }
  .board .body:has(.pick:nth-of-type(${k}):checked) .timeline label[data-k="${k}"] .step-label { color: var(--ink); font-weight: 560; }
  .board .body:has(.pick:nth-of-type(${k}):focus-visible) .timeline label[data-k="${k}"] { outline: 2px solid var(--accent); outline-offset: 2px; }`).join("");
---
{board ? (
  <section class="board" style={`--n:${predictors.length}`}>
    <div class="board-tools">
      <div class="search" hidden>
        <label for="case-search">Find a case</label>
        <input id="case-search" type="search" autocomplete="off" spellcheck="false"
          placeholder="Party name, docket number, or topic" aria-describedby="case-search-status" />
        <p id="case-search-status" class="search-status" aria-live="polite"></p>
      </div>
      {chips.length > 0 && (
        <div class="topics" role="group" aria-labelledby="topics-label" hidden>
          <span id="topics-label" class="topics-label">Topic</span>
          <button type="button" class="chip" data-topic="" aria-pressed="true">All <span class="count">{rows.length}</span></button>
          {chips.map((c) => <button type="button" class="chip" data-topic={c.key} aria-pressed="false">{c.name} <span class="count">{c.n}</span></button>)}
          {noTopic > 0 && <button type="button" class="chip" data-topic="none" aria-pressed="false">No topic <span class="count">{noTopic}</span></button>}
        </div>
      )}
      <p class="scale">Big-case score · 0 = routine, 1 = landmark</p>
    </div>
    <div class="row head" role="row">
      <div class="case">Case</div>
      {predictors.map((p) => <div class="num" title={p}>{shortName(p)}</div>)}
      <div class="num mean">Average</div>
    </div>

    {top.map((row) => <Entry row={row} />)}
    {rest.length > 0 && (
      <details class="fold">
        <summary class="more"><span class="show">Show all {rows.length} cases</span><span class="hide">Show fewer</span></summary>
        {rest.map((row) => <Entry row={row} />)}
      </details>
    )}

    <p class="no-match" hidden>No cases on the board match. The board lists only cases the models have predicted and scored; the <a href="/ledger">ledger</a> has every predicted event.</p>
    <p class="foot">
      {board.cases} cases · {board.scored_reads} scores
      {board.rows_with_leakage_flag > 0 && <span> · {board.rows_with_leakage_flag} with a <a href="#possible-leak">possible leak</a></span>}
      {board.cases_without_score > 0 && <span> · {board.cases_without_score} predicted cases carry no score and are not listed</span>}
    </p>
  </section>
) : (
  <div class="empty"><p>The big-case board has not been published to the ledger yet.</p></div>
)}

<script>
  // Case search and topic filter: progressive enhancement over the static
  // board. Without JavaScript both stay hidden and the board is unchanged.
  // Every word typed must appear in the case's name, docket numbers, topic, or
  // summary, and a chosen topic must be the case's primary one ("none" is the
  // cases without a tag); the two combine, and matches keep the board's order.
  // Both are kept in the URL (?q=, ?topic=) so a view can be linked to.
  const board = document.querySelector(".board");
  const box = board?.querySelector(".search");
  const input = board?.querySelector("#case-search");
  if (board && box && input) {
    const norm = (t) => (t ?? "").normalize("NFKD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9-]+/g, " ");
    const entries = [...board.querySelectorAll("details.entry")].map((el) => ({
      el,
      topic: el.dataset.topic ?? "none",
      text: " " + norm([
        el.querySelector(".caption")?.textContent,
        el.querySelector(".ident .full")?.textContent,
        el.querySelector(".headline")?.textContent,
        el.dataset.case, el.dataset.case?.split("/")[1], el.dataset.docket,
        ...[...el.querySelectorAll(".tag.topic, .ident a")].map((t) => t.textContent),
        el.querySelector(".summary .cols")?.textContent,
      ].join(" ")) + " ",
    }));
    const chipBox = board.querySelector(".topics");
    const chips = chipBox ? [...chipBox.querySelectorAll(".chip")] : [];
    const known = new Set(chips.map((c) => c.dataset.topic));
    let topic = "";
    const fold = board.querySelector("details.fold");
    const status = board.querySelector("#case-search-status");
    const none = board.querySelector(".no-match");
    let foldWasOpen = fold?.open ?? false;
    let active = false;

    const run = () => {
      const terms = norm(input.value).split(" ").filter(Boolean);
      const on = terms.length > 0 || topic !== "";
      if (on && !active && fold) foldWasOpen = fold.open;
      let n = 0;
      for (const { el, text, topic: k } of entries) {
        const hit = (!topic || k === topic) && terms.every((t) => text.includes(t));
        el.hidden = !hit;
        if (hit) n++;
      }
      board.classList.toggle("searching", on);
      if (fold) fold.open = on ? true : foldWasOpen;
      none.hidden = !on || n > 0;
      status.textContent = on ? (n === 1 ? "1 case matches" : `${n} cases match`) : "";
      active = on;
      const url = new URL(location.href);
      if (terms.length) url.searchParams.set("q", input.value.trim()); else url.searchParams.delete("q");
      if (topic) url.searchParams.set("topic", topic); else url.searchParams.delete("topic");
      history.replaceState(null, "", url);
    };

    const pick = (k) => {
      topic = known.has(k) ? k : "";
      for (const c of chips) c.setAttribute("aria-pressed", String(c.dataset.topic === topic));
    };
    for (const c of chips) c.addEventListener("click", () => { pick(c.dataset.topic === topic ? "" : c.dataset.topic); run(); });

    box.hidden = false;
    if (chipBox) chipBox.hidden = false;
    input.addEventListener("input", run);
    input.addEventListener("keydown", (e) => { if (e.key === "Escape" && input.value) { input.value = ""; run(); } });
    const params = new URLSearchParams(location.search);
    const q = params.get("q");
    if (q) input.value = q;
    pick(params.get("topic") ?? "");
    if (q || topic) run();
  }
</script>

<style is:global set:html={pickCss}></style>
<style is:global>
  .board { --score-w: 4.6rem; margin: 1.5rem 0 2rem; font-variant-numeric: tabular-nums; }
  .board .board-tools { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0.4rem 1.5rem; margin: 0 0 0.3rem; }
  .board .scale { color: var(--muted); font-size: 0.86rem; margin: 0; text-align: right; margin-left: auto; }
  .board .search { flex: 1 1 18rem; max-width: 26rem; }
  .board .search[hidden] { display: none; }
  .board .search label { display: block; font-size: 0.86rem; font-weight: 560; margin-bottom: 0.2rem; }
  .board .search input {
    width: 100%; font: inherit; font-size: 0.95rem; color: var(--ink); background: var(--paper);
    border: 1px solid var(--rule); border-radius: 4px; padding: 0.4rem 0.6rem;
  }
  .board .search input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }
  .board .topics { flex: 1 1 100%; order: 3; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem; margin: 0.2rem 0 0.4rem; }
  .board .topics[hidden] { display: none; }
  .board .topics-label { font-size: 0.86rem; font-weight: 560; margin-right: 0.2rem; }
  .board .chip {
    font: inherit; font-size: 0.8rem; line-height: 1.3; color: var(--ink); background: var(--paper);
    border: 1px solid var(--rule); border-radius: 999px; padding: 0.15rem 0.6rem; cursor: pointer;
  }
  .board .chip .count { color: var(--muted); font-variant-numeric: tabular-nums; }
  .board .chip:hover { border-color: var(--accent); }
  .board .chip[aria-pressed="true"] { background: var(--accent-soft); border-color: var(--accent); font-weight: 560; }
  .board .chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .board .search-status { font-size: 0.8rem; color: var(--muted); margin: 0.25rem 0 0; min-height: 1.2em; }
  .board.searching .fold > .more { display: none; }
  .board .no-match { color: var(--muted); padding: 0.8rem 0 0.8rem 1.1rem; border-bottom: 1px solid var(--rule); }
  .board .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) repeat(var(--n), var(--score-w)) 5.4rem;
    gap: 0 0.5rem;
    align-items: baseline;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .board .row.head { font-weight: 560; border-bottom-color: var(--ink); font-size: 0.92rem; }
  .board .num { text-align: right; }
  .board .mean { font-weight: 560; }
  .board .mean small { font-weight: 400; color: var(--muted); font-size: 0.72rem; display: block; white-space: nowrap; }
  .board .bar { display: block; height: 3px; background: var(--rule); margin-top: 0.3rem; border-radius: 2px; overflow: hidden; }
  .board .bar span { display: block; height: 100%; background: var(--accent); }

  /* summary as the row: no marker, whole row clickable */
  .board summary { cursor: pointer; list-style: none; }
  .board summary::-webkit-details-marker { display: none; }
  .board summary:hover .caption { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.15em; }
  .board .caption {
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
    padding-left: 1.1rem; position: relative;
  }
  .board .caption.short { display: block; -webkit-line-clamp: unset; }
  .board .headline {
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
    padding-left: 1.1rem; margin-top: 0.1rem; color: var(--muted); font-size: 0.88rem; line-height: 1.35;
  }
  .board details[open] > summary .headline { display: none; }
  .board .caption::before { content: "›"; position: absolute; left: 0; top: -0.05em; color: var(--muted); transition: transform 0.15s; }
  .board details[open] > summary .caption::before { transform: rotate(90deg); }
  .board .meta { display: block; padding-left: 1.1rem; margin-top: 0.15rem; }
  .board .tag { display: inline-block; font-family: var(--mono); font-size: 0.7rem; color: var(--muted); border: 1px solid var(--rule); border-radius: 3px; padding: 0 0.35em; margin-right: 0.35em; vertical-align: 0.1em; text-decoration: none; }
  .board .tag.warn { color: var(--accent); border-color: var(--accent); }

  .board .body { position: relative; padding: 0.6rem 0 1rem 1.1rem; border-bottom: 1px solid var(--rule); background: color-mix(in srgb, var(--accent-soft) 45%, transparent); }
  .board .ident { color: var(--muted); font-size: 0.82rem; margin: 0 0 0.6rem; }
  .board .summary { margin: 0.2rem 0 1.2rem; padding: 0.2rem 0 0.8rem; border-bottom: 1px solid var(--rule); }
  /* narrow screens: one readable measure for every block of the summary */
  .board .summary .lead, .board .summary .cols, .board .summary .wide, .board .summary .provenance { max-width: 62ch; }
  @media (min-width: 900px) {
    /* the three sections side by side, so the summary uses the page's width without long lines */
    .board .summary .cols { max-width: none; display: grid; grid-template-columns: 1.15fr 1fr 0.85fr; gap: 0 1.8rem; }
    /* every block of the summary runs to the same right edge as the columns */
    .board .summary .lead, .board .summary .wide, .board .summary .provenance { max-width: none; }
    .board .summary > * { padding-right: 1.1rem; }
  }
  .board .summary h3 { font-size: 0.95rem; margin: 0.9rem 0 0.2rem; }
  .board .summary .col > h3:first-child { margin-top: 0.2rem; }
  @media (max-width: 899px) { .board .summary .col + .col > h3:first-child { margin-top: 0.9rem; } }
  .board .summary p { margin: 0 0 0.5rem; font-size: 0.95rem; }
  .board .summary .lead { font-size: 1rem; margin: 0.2rem 0 0.4rem; }
  .board .summary .wide h3 { margin-top: 0.6rem; }
  .board .summary .provenance { color: var(--muted); font-size: 0.8rem; margin-top: 0.8rem; }
  .board .predictions-head { font-size: 0.8rem; font-weight: 560; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); margin: 0.4rem 0 0; }
  .board .ident .full { display: block; color: var(--ink); font-size: 0.92rem; margin-bottom: 0.2rem; }
  .board .event h3 { font-size: 1rem; margin: 0.9rem 0 0.3rem; }
  .board .ev-meta { display: block; font-weight: 400; font-size: 0.82rem; color: var(--muted); margin-top: 0.1rem; }
  .board .ev-meta strong { color: var(--ink); }
  .board .reads { list-style: none; padding: 0; margin: 0 0 0.4rem; }
  .board .read { padding: 0.45rem 0 0.45rem 0.7rem; border-left: 2px solid var(--rule); margin: 0.3rem 0; }
  .board .read.current { border-left-color: var(--accent); }
  .board .read-head { display: flex; flex-wrap: wrap; gap: 0.2rem 0.8rem; align-items: baseline; font-size: 0.92rem; }
  .board .who { font-weight: 560; min-width: 4.5rem; }
  .board .figs { color: var(--muted); }
  .board .figs strong, .board .figs em { color: var(--ink); }
  .board .sep { margin: 0 0.35em; }
  .board .cell { margin-left: auto; font-size: 0.86rem; white-space: nowrap; }
  .board .why { margin: 0.25rem 0 0; font-size: 0.92rem; max-width: 60ch; }
  .board .foot { color: var(--muted); font-size: 0.86rem; margin-top: 0.8rem; }

  .board .tag.topic { color: var(--ink); background: var(--accent-soft); border-color: transparent; font-family: var(--serif); font-size: 0.74rem; }

  /* timeline: one track per stage the case has reached; steps are a row of dots on a line */
  .board .timeline { margin: 0.5rem 0 1.1rem; padding-right: 1.1rem; }
  .board .track + .track { margin-top: 0.6rem; }
  .board .track-name { font-size: 0.72rem; font-family: var(--mono); color: var(--muted); margin: 0 0 0.2rem; }
  .board .timeline ol { list-style: none; margin: 0; padding: 0; display: flex; }
  .board .step { flex: 1 1 0; margin: 0; position: relative; min-width: 0; }
  .board .step > label, .board .step > div { display: flex; flex-direction: column; gap: 0.05rem; padding: 0 0.4rem 0 0; font-size: 0.8rem; line-height: 1.25; color: var(--muted); border-radius: 3px; }
  .board .step > label { cursor: pointer; }
  .board .step > label:hover .step-label { text-decoration: underline; text-decoration-color: var(--accent); }
  /* the line: drawn from each dot to the next */
  .board .step::before { content: ""; position: absolute; left: 0.5rem; right: 0; top: 0.42rem; height: 2px; background: var(--rule); }
  .board .step:last-child::before { display: none; }
  .board .step.done:has(+ .step.done)::before { background: var(--accent); }
  .board .dot { position: relative; width: 0.85rem; height: 0.85rem; border-radius: 50%; border: 2px solid var(--rule); background: var(--paper); margin-bottom: 0.25rem; }
  .board .step.done .dot { border-color: var(--accent); background: var(--accent-soft); }
  .board .step.decision .dot { border-radius: 2px; transform: rotate(45deg) scale(0.85); }
  .board .step.decision.done .dot { background: var(--accent); }
  .board .step.now .step-label { color: var(--ink); }
  .board .step-outcome { color: var(--ink); font-weight: 560; }
  .board .step-date { font-size: 0.74rem; }
  .board .step-pred { font-family: var(--mono); font-size: 0.66rem; color: var(--accent); }
  .board .fork { font-size: 0.82rem; color: var(--muted); margin: 0.45rem 0 0; }
  .board .fork strong { color: var(--ink); font-weight: 560; }
  .board .outcome-lines { list-style: none; padding: 0; max-width: 62ch; }
  .board .outcome-lines li { margin: 0.15rem 0; }

  /* the radios behind the timeline: kept focusable, never seen */
  .board .picks { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .board .body:has(.pick:checked) .events > .event { display: none; }
  .board .pick-hint { font-size: 0.82rem; color: var(--muted); margin: 0.2rem 0 0; }

  /* the "show all" fold: a summary that stands alone, followed by its siblings */
  .board .more { display: block; padding: 0.7rem 0 0.7rem 1.1rem; color: var(--accent); border-bottom: 1px solid var(--rule); }
  .board .more .hide { display: none; }
  .board .fold[open] > .more .hide { display: inline; }
  .board .fold[open] > .more .show { display: none; }

  @media (max-width: 560px) {
    /* stack: caption on its own line, the scores as a labelled strip beneath */
    .board .row { grid-template-columns: repeat(var(--n), 1fr) 1.3fr; gap: 0.2rem 0.6rem; font-size: 0.95rem; }
    .board .row.head { display: none; }
    .board .scale { text-align: left; }
    /* one scrolling row of chips rather than a wall of them above the board */
    .board .topics { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 0.3rem; scrollbar-width: thin; }
    .board .chip, .board .topics-label { flex: none; white-space: nowrap; }
    .board .case { grid-column: 1 / -1; }
    .board .num { text-align: left; padding-left: 1.1rem; }
    .board .num::before { content: attr(data-label); display: block; font-size: 0.68rem; color: var(--muted); font-family: var(--mono); letter-spacing: 0.02em; }
    .board .body { padding-left: 0; }
    .board .timeline, .board .summary .cols { padding-right: 0; }
    .board .step > label, .board .step > div { font-size: 0.72rem; }
    .board .step-pred { display: none; }
    .board .step.predicted .dot { border-width: 3px; }
    .board .cell { margin-left: 0; }
  }
</style>
