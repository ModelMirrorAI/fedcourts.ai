---
// The big-case board: one row per predicted case, each model's current
// big-case score and the panel average, ranked average-first. Rendered straight
// from metrics/big-cases.json as copied into ledger.json at build time; nothing
// is recomputed here. Rows expand (plain <details>, no JS) to the case's predicted
// events and every model's newest read of each, linked to the committed cell.
// The first SHOW rows are open to the page; the rest sit behind a second <details>.
import ledger from "../data/ledger.json";
import Entry from "./BigCaseEntry.astro";

const SHOW = 25;

const board = ledger.metrics?.big_cases ?? null;
const predictors = board?.predictors ?? [];
const rows = board?.rows ?? [];
const top = rows.slice(0, SHOW);
const rest = rows.slice(SHOW);

// Display names: strip the "-baseline" suffix the ledger uses and capitalize.
const shortName = (id) => {
  const base = id.replace(/-baseline$/, "");
  return base.charAt(0).toUpperCase() + base.slice(1);
};
---
{board ? (
  <section class="board" style={`--n:${predictors.length}`}>
    <p class="scale">Big-case score · 0 = routine, 1 = landmark</p>
    <div class="row head" role="row">
      <div class="case">Case</div>
      {predictors.map((p) => <div class="num" title={p}>{shortName(p)}</div>)}
      <div class="num mean">Average</div>
    </div>

    {top.map((row) => <Entry row={row} />)}
    {rest.length > 0 && (
      <details class="fold">
        <summary class="more"><span class="show">Show all {rows.length} cases</span><span class="hide">Show fewer</span></summary>
        {rest.map((row) => <Entry row={row} />)}
      </details>
    )}

    <p class="foot">
      {board.cases} cases · {board.scored_reads} scores
      {board.rows_with_leakage_flag > 0 && <span> · {board.rows_with_leakage_flag} with a <a href="#possible-leak">possible leak</a></span>}
      {board.cases_without_score > 0 && <span> · {board.cases_without_score} predicted cases carry no score and are not listed</span>}
    </p>
  </section>
) : (
  <div class="empty"><p>The big-case board has not been published to the ledger yet.</p></div>
)}

<style is:global>
  .board { --score-w: 4.6rem; margin: 1.5rem 0 2rem; font-variant-numeric: tabular-nums; }
  .board .scale { color: var(--muted); font-size: 0.86rem; margin: 0 0 0.3rem; text-align: right; }
  .board .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) repeat(var(--n), var(--score-w)) 5.4rem;
    gap: 0 0.5rem;
    align-items: baseline;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .board .row.head { font-weight: 560; border-bottom-color: var(--ink); font-size: 0.92rem; }
  .board .num { text-align: right; }
  .board .mean { font-weight: 560; }
  .board .mean small { font-weight: 400; color: var(--muted); font-size: 0.72rem; display: block; white-space: nowrap; }
  .board .bar { display: block; height: 3px; background: var(--rule); margin-top: 0.3rem; border-radius: 2px; overflow: hidden; }
  .board .bar span { display: block; height: 100%; background: var(--accent); }

  /* summary as the row: no marker, whole row clickable */
  .board summary { cursor: pointer; list-style: none; }
  .board summary::-webkit-details-marker { display: none; }
  .board summary:hover .caption { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.15em; }
  .board .caption {
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
    padding-left: 1.1rem; position: relative;
  }
  .board .caption::before { content: "›"; position: absolute; left: 0; top: -0.05em; color: var(--muted); transition: transform 0.15s; }
  .board details[open] > summary .caption::before { transform: rotate(90deg); }
  .board .meta { display: block; padding-left: 1.1rem; margin-top: 0.15rem; }
  .board .tag { display: inline-block; font-family: var(--mono); font-size: 0.7rem; color: var(--muted); border: 1px solid var(--rule); border-radius: 3px; padding: 0 0.35em; margin-right: 0.35em; vertical-align: 0.1em; text-decoration: none; }
  .board .tag.warn { color: var(--accent); border-color: var(--accent); }

  .board .body { padding: 0.6rem 0 1rem 1.1rem; border-bottom: 1px solid var(--rule); background: color-mix(in srgb, var(--accent-soft) 45%, transparent); }
  .board .ident { color: var(--muted); font-size: 0.82rem; margin: 0 0 0.6rem; }
  .board .summary { max-width: 62ch; margin: 0.2rem 0 1.2rem; padding: 0.2rem 0 0.8rem; border-bottom: 1px solid var(--rule); }
  .board .summary h3 { font-size: 0.95rem; margin: 0.9rem 0 0.2rem; }
  .board .summary h3:first-child { margin-top: 0.2rem; }
  .board .summary p { margin: 0 0 0.5rem; font-size: 0.95rem; }
  .board .summary .provenance { color: var(--muted); font-size: 0.8rem; margin-top: 0.8rem; }
  .board .predictions-head { font-size: 0.8rem; font-weight: 560; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); margin: 0.4rem 0 0; }
  .board .ident .full { display: block; color: var(--ink); font-size: 0.92rem; margin-bottom: 0.2rem; }
  .board .event h3 { font-size: 1rem; margin: 0.9rem 0 0.3rem; }
  .board .ev-meta { display: block; font-weight: 400; font-size: 0.82rem; color: var(--muted); margin-top: 0.1rem; }
  .board .ev-meta strong { color: var(--ink); }
  .board .reads { list-style: none; padding: 0; margin: 0 0 0.4rem; }
  .board .read { padding: 0.45rem 0 0.45rem 0.7rem; border-left: 2px solid var(--rule); margin: 0.3rem 0; }
  .board .read.current { border-left-color: var(--accent); }
  .board .read-head { display: flex; flex-wrap: wrap; gap: 0.2rem 0.8rem; align-items: baseline; font-size: 0.92rem; }
  .board .who { font-weight: 560; min-width: 4.5rem; }
  .board .figs { color: var(--muted); }
  .board .figs strong, .board .figs em { color: var(--ink); }
  .board .sep { margin: 0 0.35em; }
  .board .cell { margin-left: auto; font-size: 0.86rem; white-space: nowrap; }
  .board .why { margin: 0.25rem 0 0; font-size: 0.92rem; max-width: 60ch; }
  .board .foot { color: var(--muted); font-size: 0.86rem; margin-top: 0.8rem; }

  /* the "show all" fold: a summary that stands alone, followed by its siblings */
  .board .more { display: block; padding: 0.7rem 0 0.7rem 1.1rem; color: var(--accent); border-bottom: 1px solid var(--rule); }
  .board .more .hide { display: none; }
  .board .fold[open] > .more .hide { display: inline; }
  .board .fold[open] > .more .show { display: none; }

  @media (max-width: 560px) {
    /* stack: caption on its own line, the scores as a labelled strip beneath */
    .board .row { grid-template-columns: repeat(var(--n), 1fr) 1.3fr; gap: 0.2rem 0.6rem; font-size: 0.95rem; }
    .board .row.head { display: none; }
    .board .scale { text-align: left; }
    .board .case { grid-column: 1 / -1; }
    .board .num { text-align: left; padding-left: 1.1rem; }
    .board .num::before { content: attr(data-label); display: block; font-size: 0.68rem; color: var(--muted); font-family: var(--mono); letter-spacing: 0.02em; }
    .board .body { padding-left: 0; }
    .board .cell { margin-left: 0; }
  }
</style>
