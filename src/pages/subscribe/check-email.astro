---
// Buttondown redirects here after the signup form is submitted
// (Settings: subscription redirect URL).
import Base from "../../layouts/Base.astro";
---
<Base title="Check your email" description="Confirm your email signup for FedCourtsAI release updates." noindex>
  <h1>Check your email</h1>
  <p>
    We've sent a confirmation link to the address you entered. Click it to finish signing up.
    Nothing else is sent until you do.
  </p>
  <p>
    The email comes from <code>updates@fedcourts.ai</code>. If it hasn't arrived in a few minutes, check your spam folder.
    If you didn't mean to sign up, ignore it and you won't hear from us.
  </p>
  <p><a href="/">Back to the board</a></p>
</Base>
