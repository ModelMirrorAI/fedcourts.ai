---
// The Data page: the analytics roll-ups fedcourtsai commits under metrics/,
// linked at the exact commit this build read, an index of the statpack's
// per-Term counts, and the docket pack's topic mix by stage. Every figure is
// copied from metrics/statpack.json or metrics/docket.json; a file the commit
// does not carry is not listed.
import Base from "../layouts/Base.astro";
import Stamp from "../components/Stamp.astro";
import ledger from "../data/ledger.json";

const { repo, sha } = ledger.source;
const ref = sha ?? "main";
const blob = (path: string) => `https://github.com/${repo}/blob/${ref}/${path}`;
const tree = (path: string) => `https://github.com/${repo}/tree/${ref}/${path}`;
const files = new Set<string>(ledger.metrics.files ?? []);
const has = (path: string) => files.has(path);

// What each roll-up is. Descriptions say what a file holds, never what it shows.
const catalog = [
  {
    name: "Docket pack",
    base: "metrics/docket",
    what: "Facts about the Supreme Court's dockets: what it is asked to take, from which court below, on which fee stream, after how many relists, and how it disposes of petitions, by October Term. It makes no claim about the predictions.",
  },
  {
    name: "Stat pack",
    base: "metrics/statpack",
    what: "The base rates the predictions are anchored on and scored against: cert petitions by Term and by salience band, the interim (applications) docket, and merits outcomes for granted cases.",
  },
  {
    name: "Big-case board",
    base: "metrics/big-cases",
    what: "Each model's view of how consequential each pending case is: the data behind the front-page board.",
  },
  {
    name: "Leaderboard",
    base: "metrics/leaderboard",
    what: "The models ranked on their graded forecasts, in the pre-registered (frozen) scope only.",
  },
  {
    name: "Claim scores",
    base: "metrics/claim-scores",
    what: "Each model's mechanically scored claims, pooled per model and per stratum, published beside the leaderboard.",
  },
  {
    name: "Backtest",
    base: "metrics/backtest",
    what: "Simple baseline predictors replayed over cases decided long ago, each shown beside the always-deny floor. It measures recall of known history, not foresight.",
  },
  {
    name: "Cert backtest",
    base: "metrics/cert-backtest",
    what: "The models replayed on decided cert petitions with the outcome hidden, scored against a base rate that could have been known at the time.",
  },
]
  .map((a) => ({ ...a, md: has(`${a.base}.md`), json: has(`${a.base}.json`) }))
  .filter((a) => a.md || a.json);

const hasUpdates = [...files].some((f) => f.startsWith("metrics/updates/"));

// Index by October Term: one row per Term the cert or merits section covers.
const byTerm = ledger.metrics.statpack_by_term;
const cert = new Map((byTerm?.cert ?? []).map((t: any) => [t.term, t]));
const interim = new Map((byTerm?.interim ?? []).map((t: any) => [t.term, t]));
const merits = new Map((byTerm?.merits ?? []).map((t: any) => [t.term, t]));
const terms = [...new Set([...cert.keys(), ...merits.keys()])].sort((a, b) => b - a);
const n = (v: unknown) => (typeof v === "number" ? v.toLocaleString("en-US") : "—");
const statpackMd = blob("metrics/statpack.md");

// The docket pack's topic mix: one column per stage, rows in the order the
// stages list them, each share a share of its own stage.
const mix: any[] = ledger.metrics.topic_mix ?? [];
const mixLabels: string[] = [];
for (const stage of mix) for (const s of stage.shares) if (!mixLabels.includes(s.label)) mixLabels.push(s.label);
const mixShare = mix.map((stage) => new Map(stage.shares.map((s: any) => [s.label, s])));
// Rounded on the share itself, as the docket pack rounds it, so a tie the
// binary value sits just below rounds the same way on both.
const pct = (v: unknown) => (typeof v === "number" ? `${(Number(v.toFixed(3)) * 100).toFixed(1)}%` : "—");
const stageName: Record<string, string> = { cert: "Cert petitions", merits: "Merits cases", interim: "Emergency applications" };
const stageCount = (stage: any) =>
  stage.cases === stage.rows ? `n=${n(stage.cases)}` : `est. n=${n(stage.cases)}; ${n(stage.rows)} rows`;
const docketMd = blob("metrics/docket.md");
---
<Base
  title="Data"
  description="The analytics FedCourtsAI publishes: the docket pack, the stat pack, the leaderboard and the backtests, each linked at the commit this site read."
  wide
>
  <h1>Data</h1>
  <p class="intro">
    Alongside the predictions, the <a href={`https://github.com/${repo}`}>public repository</a> commits a set of
    roll-ups under <code>metrics/</code>: counts and rates about the Court's dockets, and the scores of the models.
    A scheduled job regenerates and commits each one, so any figure can be traced to the commit that produced it.
    The links below point to the commit this site was built from. Before quoting a number, read{" "}
    <a href={blob("metrics/README.md")}>the metrics guide</a>: it explains what each figure measures and what can be
    claimed from it.
  </p>
  <p><Stamp /></p>

  <section aria-labelledby="files-h">
    <h2 id="files-h">The roll-ups</h2>
    <ul class="catalog">
      {catalog.map((a) => (
        <li>
          <h3>{a.name}</h3>
          <p>{a.what}</p>
          <p class="links">
            {a.md && <a href={blob(`${a.base}.md`)}>Read it ↗</a>}
            {a.md && a.json && " · "}
            {a.json && <a href={blob(`${a.base}.json`)}>JSON ↗</a>}
          </p>
        </li>
      ))}
      {hasUpdates && (
        <li>
          <h3>Weekly updates</h3>
          <p>One short account per week of what the Court did and what the models predicted, generated from the ledger.</p>
          <p class="links"><a href={tree("metrics/updates")}>All weeks ↗</a></p>
        </li>
      )}
    </ul>
  </section>

  {terms.length > 0 && (
    <section aria-labelledby="terms-h">
      <h2 id="terms-h">By October Term</h2>
      <p>
        A few counts for each Term, copied from the stat pack. Each column heading links to the stat pack section it
        comes from, which has the rest of that Term's figures and the caveats for reading them.
      </p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Term</th>
              <th scope="col" class="num"><a href={`${statpackMd}#scotus-cert-petitions-by-term`}>Cert petitions filed (paid / IFP)</a></th>
              <th scope="col" class="num"><a href={`${statpackMd}#scotus-cert-petitions-by-term`}>Cert grants</a></th>
              <th scope="col" class="num"><a href={`${statpackMd}#the-interim-docket-applications`}>Applications</a></th>
              <th scope="col" class="num"><a href={`${statpackMd}#the-merits-docket-granted-cases`}>Merits cases (granted / decided)</a></th>
            </tr>
          </thead>
          <tbody>
            {terms.map((term) => {
              const c: any = cert.get(term);
              const i: any = interim.get(term);
              const m: any = merits.get(term);
              return (
                <tr>
                  <th scope="row">OT{term}</th>
                  <td class="num">{c ? `${n(c.filings?.paid)} / ${n(c.filings?.ifp)}` : "—"}</td>
                  <td class="num">{n(c?.grants)}</td>
                  <td class="num">{n(i?.applications)}</td>
                  <td class="num">{m ? `${n(m.granted)} / ${n(m.parsed)}` : "—"}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="note">
        Filings count docketed numbers, a slight upper bound on real petitions. Grants are those observed in the
        corpus. Applications include requests for more time. A merits case counts as decided once its judgment has
        been parsed. A Term still under way shows only what has happened so far.
      </p>
    </section>
  )}

  {mix.length > 0 && (
    <section aria-labelledby="topics-h">
      <h2 id="topics-h">By topic</h2>
      <p>
        The share of each stage's labeled cases under each topic, copied from the{" "}
        <a href={`${docketMd}#topic-mix-by-stage`}>docket pack</a>. Each column is a share of its own stage, never of
        the whole docket, and the columns are not steps of one funnel: they cover different cases, labeled to very
        different depths and from different inputs. Read each column's scope note below the table before quoting
        a share. Labeled rows on hand are in parentheses.
      </p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Topic</th>
              {mix.map((stage) => (
                <th scope="col" class="num">{stageName[stage.stage] ?? stage.stage} ({stageCount(stage)})</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {mixLabels.map((label) => (
              <tr>
                <th scope="row">{label}</th>
                {mixShare.map((shares) => {
                  const s: any = shares.get(label);
                  return <td class="num">{s ? `${pct(s.share)} (${n(s.rows)})` : "—"}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {mix.map((stage) => (
        <p class="note"><strong>{stageName[stage.stage] ?? stage.stage}:</strong> {stage.scope_note}</p>
      ))}
    </section>
  )}
</Base>

<style>
  .intro { max-width: var(--wide); }
  .catalog { list-style: none; padding: 0; margin: 0 0 2rem; }
  .catalog li { border-top: 1px solid var(--rule); padding: 0.9rem 0 0.3rem; }
  .catalog li:last-child { border-bottom: 1px solid var(--rule); }
  .catalog h3 { margin: 0 0 0.3rem; }
  .catalog p { margin: 0 0 0.4rem; }
  .catalog .links { font-size: 0.92rem; }
  tbody th { font-weight: 560; border-bottom-color: var(--rule); }
  .note { font-size: 0.88rem; color: var(--muted); }
</style>
